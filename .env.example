# deployment-ui Configuration
VITE_DEPLOYMENT_API_URL=http://localhost:8004
VITE_SKIP_AUTH=true

# Auth provider: google (default) | cognito
VITE_AUTH_PROVIDER=google

# Firebase Google sign-in — used when VITE_AUTH_PROVIDER=google (2026-08-12,
# replaces a hand-rolled OAuth implicit flow; see src/auth/GoogleAuth.tsx).
# Public client config — reuses the same Firebase project as
# unified-trading-system-ui (see that repo's .env.production for the source).
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# AWS Cognito OAuth PKCE — used when VITE_AUTH_PROVIDER=cognito
VITE_COGNITO_CLIENT_ID=your-cognito-app-client-id
VITE_COGNITO_DOMAIN=https://your-user-pool-domain.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
