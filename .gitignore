# --- Keep these (do not ignore): uv.lock, package.json, .env.example, tsconfig.json ---
# --- Repo-specific exceptions (add below; sync preserves this section) ---
# Playwright generates this report dir on every test run — never commit it
# (matches unified-trading-system-ui). orchestrator_autonomy_residual_findings_2026_06_02 FM3.
playwright-report/
# src/data/ holds static JSON bundled by Vite (capability-manifest.json etc.)
# The global `data/` pattern would exclude these; unignore explicitly.
!src/data/

# =============================================================================
# Central .gitignore — workspace SSOT (Python + React/TS + security)
# Copy to repo root as .gitignore. Source: unified-trading-pm/scripts/templates/
# =============================================================================

# --- Security (never commit credentials) ---
*credentials*.json
*-credentials.json
*-service-account.json
workspace-dev-sa-key.json
service-account*.json
*secret*.json
central-element-323112-*.json
.env
.env.local
.env.*.local
.env.production
**/secrets/
**/credentials/
*.p12
*.json.bak

# --- OS / editor ---
.DS_Store
.DS_Store?
Thumbs.db
*.backup
*~
*.swp
*.swo
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.hypothesis/
.ruff_cache/
.cache/
*.egg-info/
.eggs/
*.egg
*.so
.Python
.tox/
.nox/
.pyre/
.pytype/
.ropeproject
.spyderproject
.spyproject

# --- Python venvs ---
.venv/
.venv*/
venv/
venv*/
.venv-workspace/
ENV/
env/

# --- Node / React / TypeScript ---
# No trailing slash: in per-slot worktrees node_modules is a SYMLINK (shared install),
# and "node_modules/" matches directories only → the symlink stays untracked + un-ignored,
# leaving the slot perpetually dirty (ff-pull cron then [skip:dirty]s it → drift). Plain
# "node_modules" matches a dir OR a symlink.
node_modules
.next/
dist/
build/
.turbo/
.nyc_output/

# --- Coverage / test artifacts ---
.coverage
.coverage.*
coverage/
coverage.xml
htmlcov/
nosetests.xml

# --- Data / logs (repo-local, not for git) ---
data/
logs/
*.log

# --- Common data / document file types (generated or local, not for git) ---
# Uncomment or add !tests/fixtures/*.csv if the repo commits CSV fixtures
*.csv
*.xlsx
*.xls
*.xlsm
*.ppt
*.pptx
*.pptm
*.doc
*.docx
*.docm
*.pdf
*.parquet
*.tsv
*.ods
*.odt
*.odp

# --- Optional: Terraform (uncomment if repo has Terraform) ---
# **/.terraform/
# *.tfstate
# *.tfstate.*
# *.tfplan
# crash.log
# crash.*.log
# override.tf
# override.tf.json
# *_override.tf
# *_override.tf.json
# *.auto.tfvars

# --- Optional: Jupyter (uncomment if repo has notebooks) ---
# .ipynb_checkpoints/
# profile_default/
test-results/

# Orphan-route audit runtime report (scanner regenerates on every run)
scripts/.orphan-audit-report.json

# Quality-gate local caches (regenerated each run — never commit; SSOT: CLAUDE.md + cicd_contract_hardening item H)
.qg_last_passed_sha
.qg_content_sentinel

# Re-include src/data/ — static JSON bundled by Vite (capability-manifest.json).
# The global `data/` pattern above would exclude these; this exception must appear
# AFTER that pattern for gitignore precedence rules to apply correctly.
!src/data/
!src/data/**
